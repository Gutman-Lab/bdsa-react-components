{
    "name": "bdsa-react-components",
    "version": "0.5.0",
    "description": "Reusable React components for the Digital Slide Archive project",
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./styles.css": "./dist/index.css",
        "./schemas/*": "./dist/schemas/*",
        "./schemas/clinical-metadata.json": "./dist/schemas/clinical-metadata.json",
        "./schemas/region-metadata.json": "./dist/schemas/region-metadata.json",
        "./schemas/stain-metadata.json": "./dist/schemas/stain-metadata.json",
        "./schemas/slide-level-metadata.json": "./dist/schemas/slide-level-metadata.json",
        "./package.json": "./package.json",
        "./components/DsaAuthManager": {
            "types": "./dist/entries/dsa-auth-manager.d.ts",
            "import": "./dist/components/DsaAuthManager/index.js",
            "require": "./dist/components/DsaAuthManager/index.cjs"
        },
        "./components/FolderBrowser": {
            "types": "./dist/entries/folder-browser.d.ts",
            "import": "./dist/components/FolderBrowser/index.js",
            "require": "./dist/components/FolderBrowser/index.cjs"
        },
        "./components/DsaThumbnailBrowser": {
            "types": "./dist/entries/dsa-thumbnail-browser.d.ts",
            "import": "./dist/components/DsaThumbnailBrowser/index.js",
            "require": "./dist/components/DsaThumbnailBrowser/index.cjs"
        },
        "./components/OSDThumbnailBrowser": {
            "types": "./dist/entries/osd-thumbnail-browser.d.ts",
            "import": "./dist/components/OSDThumbnailBrowser/index.js",
            "require": "./dist/components/OSDThumbnailBrowser/index.cjs"
        },
        "./components/ThumbnailGrid": {
            "types": "./dist/entries/thumbnail-grid.d.ts",
            "import": "./dist/components/ThumbnailGrid/index.js",
            "require": "./dist/components/ThumbnailGrid/index.cjs"
        },
        "./components/ThumbnailViewer": {
            "types": "./dist/entries/thumbnail-viewer.d.ts",
            "import": "./dist/components/ThumbnailViewer/index.js",
            "require": "./dist/components/ThumbnailViewer/index.cjs"
        },
        "./components/ManifestBrowser": {
            "types": "./dist/entries/manifest-browser.d.ts",
            "import": "./dist/components/ManifestBrowser/index.js",
            "require": "./dist/components/ManifestBrowser/index.cjs"
        },
        "./components/SlideViewer": {
            "types": "./dist/entries/slide-viewer.d.ts",
            "import": "./dist/components/SlideViewer/index.js",
            "require": "./dist/components/SlideViewer/index.cjs"
        },
        "./components/ZStackVolumeViewer": {
            "types": "./dist/entries/zstack-volume-viewer.d.ts",
            "import": "./dist/components/ZStackVolumeViewer/index.js",
            "require": "./dist/components/ZStackVolumeViewer/index.cjs"
        },
        "./components/ChannelHistograms": {
            "types": "./dist/entries/channel-histograms.d.ts",
            "import": "./dist/components/ChannelHistograms/index.js",
            "require": "./dist/components/ChannelHistograms/index.cjs"
        },
        "./components/AnnotationBrowser": {
            "types": "./dist/entries/annotation-browser.d.ts",
            "import": "./dist/components/AnnotationBrowser/index.js",
            "require": "./dist/components/AnnotationBrowser/index.cjs"
        },
        "./components/AnnotationEditor": {
            "types": "./dist/entries/annotation-editor.d.ts",
            "import": "./dist/components/AnnotationEditor/index.js",
            "require": "./dist/components/AnnotationEditor/index.cjs"
        },
        "./components/AnnotationEditorPolygons": {
            "types": "./dist/entries/annotation-editor-polygons.d.ts",
            "import": "./dist/components/AnnotationEditorPolygons/index.js",
            "require": "./dist/components/AnnotationEditorPolygons/index.cjs"
        },
        "./components/SingleBoxSlideEditor": {
            "types": "./dist/entries/single-box-slide-editor.d.ts",
            "import": "./dist/components/SingleBoxSlideEditor/index.js",
            "require": "./dist/components/SingleBoxSlideEditor/index.cjs"
        },
        "./components/ProtocolManager": {
            "types": "./dist/entries/protocol-manager.d.ts",
            "import": "./dist/components/ProtocolManager/index.js",
            "require": "./dist/components/ProtocolManager/index.cjs"
        },
        "./auth": {
            "types": "./dist/entries/auth.d.ts",
            "import": "./dist/auth/index.js",
            "require": "./dist/auth/index.cjs"
        },
        "./cache": {
            "types": "./dist/entries/cache.d.ts",
            "import": "./dist/cache/index.js",
            "require": "./dist/cache/index.cjs"
        },
        "./utils": {
            "types": "./dist/entries/item-utils.d.ts",
            "import": "./dist/utils/index.js",
            "require": "./dist/utils/index.cjs"
        }
    },
    "files": [
        "dist",
        "patches",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "prepublishOnly": "npm run build && npm run check:exports",
        "preview": "vite preview",
        "test": "vitest --watch=false",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest --coverage",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "version": "npm run build",
        "postversion": "git push && git push --tags",
        "postinstall": "patch-package",
        "check:exports": "node scripts/check-exports.mjs",
        "check:consumer-types": "tsc -p fixtures/consumer-typecheck/tsconfig.json --noEmit"
    },
    "peerDependencies": {
        "@kitware/vtk.js": "^38.0.4",
        "openseadragon": "^5.0.0",
        "paper": "^0.12.0",
        "react": "^18.0.0",
        "react-dom": "^18.0.0"
    },
    "dependencies": {
        "lucide-react": "^0.577.0",
        "patch-package": "^8.0.1",
        "postinstall-postinstall": "^2.1.0"
    },
    "devDependencies": {
        "@storybook/addon-a11y": "^10.6.5",
        "@storybook/addon-docs": "^10.6.5",
        "@storybook/addon-links": "^10.6.5",
        "@storybook/react": "^10.6.5",
        "@storybook/react-vite": "^10.6.5",
        "@testing-library/jest-dom": "^6.1.5",
        "@testing-library/react": "^14.1.2",
        "@testing-library/user-event": "^14.6.8",
        "@types/geojson": "^7946.0.13",
        "@types/node": "^25.9.9",
        "@types/openseadragon": "^5.0.2",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.2.17",
        "@typescript-eslint/eslint-plugin": "^6.14.0",
        "@typescript-eslint/parser": "^6.14.0",
        "@vitejs/plugin-react": "^6.2.1",
        "@vitest/coverage-v8": "^4.1.12",
        "@vitest/ui": "^4.1.12",
        "eslint": "^8.55.0",
        "eslint-plugin-react-hooks": "^4.6.0",
        "eslint-plugin-react-refresh": "^0.4.5",
        "eslint-plugin-storybook": "^10.6.5",
        "jsdom": "^23.0.1",
        "openseadragon": "^5.0.1",
        "osd-paperjs-annotation": "github:pearcetm/osd-paperjs-annotation",
        "paper": "^0.12.20",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "storybook": "^10.6.5",
        "typescript": "^5.3.3",
        "vite": "^8.3.5",
        "vite-plugin-dts": "^3.7.0",
        "vite-plugin-lib-inject-css": "^2.2.2",
        "vitest": "^4.1.12"
    },
    "keywords": [
        "react",
        "components",
        "digital-slide-archive",
        "bdsa",
        "ui-library"
    ],
    "author": "",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/Gutman-Lab/bdsa-react-components.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=18"
    }
}
